		(uuid "01bbf639-b108-4588-8298-53ce24b45e66")
	)
	(text "Pixhawk connector standard DS-009, JST-GH 1.25 mm. Pin 1 is VCC on every port.\nEach signal: connector, ESD array line (port-side net), series resistor, processor. CAN has no series resistors.\nN_IO_LED_SAFETY: active low, open drain. GPS1 pin 9 (GPS1_BUZZER) is the buzzer low side; FMU_BUZZER high sounds it.\nAll pins have ESD protection for static shock"
		(exclude_from_sim no)
		(at 18.034 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cfd9c12a-738c-4285-9e9c-1be1c3d01afd")
	)
	(text "Rail clamps and GPS1 3.3 V decoupling"
