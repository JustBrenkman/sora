#![enable(implicit_some)]
(
    schema: "pinmap/v1",
    kind: pinasg,
    device: "am62l32",
    target: (
        package: "ANB",
        refdes: "U3",
    ),
    peripherals: {
        "DDR0": (
            signals: {
                "A0": (
                    pin: "DDR0_A0",
                    net: "DDR_A0",
                ),
                "A1": (
